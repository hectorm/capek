{
  "name": "capek",
  "version": "0.1.0",
  "description": "Conversational AI platform",
  "author": "Héctor Molinero Fernández <hector@molinero.dev>",
  "license": "EUPL-v1.2-or-later",
  "homepage": "https://github.com/hectorm/capek",
  "repository": {
    "type": "git",
    "url": "https://github.com/hectorm/capek.git"
  },
  "bugs": {
    "url": "https://github.com/hectorm/capek/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "scripts": {
    "clean": "nuxt cleanup",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "prepare": "nuxt prepare",
    "lint": "run-s lint:typecheck lint:eslint lint:prettier",
    "lint:typecheck": "nuxt typecheck",
    "lint:eslint": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint/ ./",
    "lint:prettier": "prettier --cache --cache-strategy content --cache-location .cache/prettier --list-different ./",
    "format": "run-s format:eslint format:prettier",
    "format:eslint": "eslint --fix --cache --cache-strategy content --cache-location .cache/eslint/ ./",
    "format:prettier": "prettier --cache --cache-strategy content --cache-location .cache/prettier --write ./",
    "test": "run-s test:chromium test:firefox test:webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
