{
  "name": "capek",
  "version": "0.1.0",
  "description": "Conversational AI platform",
  "author": "Héctor Molinero Fernández <hector@molinero.dev>",
  "license": "EUPL-v1.2-or-later",
  "homepage": "https://github.com/hectorm/capek",
  "repository": {
    "type": "git",
    "url": "https://github.com/hectorm/capek.git"
  },
  "bugs": {
    "url": "https://github.com/hectorm/capek/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.28.7+sha512.2161a30a2dc64b0c0f09786496fbce5f061be96b8ff11f0bc98e6bc675e0074ceb225b9197a278f2f171e6c9fb971bd1df8932e5bc31053baccdd52b15a1ae26",
  "scripts": {
    "clean": "nuxt cleanup",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "lint": "nuxt prepare && run-p --aggregate-output lint:typecheck lint:eslint lint:prettier",
    "lint:typecheck": "vue-tsc -b --noEmit",
    "lint:eslint": "eslint --max-warnings 0 --concurrency auto --cache --cache-strategy metadata --cache-location .cache/eslint/ ./",
    "lint:prettier": "prettier --cache --cache-strategy content --cache-location .cache/prettier --list-different ./",
    "format": "run-s format:eslint format:prettier",
    "format:eslint": "eslint --fix --concurrency auto --cache --cache-strategy metadata --cache-location .cache/eslint/ ./",
    "format:prettier": "prettier --cache --cache-strategy content --cache-location .cache/prettier --write ./",
    "test": "run-s test:unit test:chromium test:firefox test:webkit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@electric-sql/pglite": "~0.5.11",
    "@electric-sql/pglite-socket": "~0.2.14",
    "@iconify-json/lucide": "~1.2.147",
    "@iconify-json/simple-icons": "~1.2.100",
    "@jitl/quickjs-wasmfile-release-asyncify": "~0.31.0",
    "@nuxt/fonts": "~1.0.1",
    "@nuxt/icon": "~2.5.1",
    "@nuxt/image": "~2.2.0",
    "@nuxt/ui": "~4.12.0",
    "@nuxtjs/color-mode": "~4.0.1",
    "@nuxtjs/i18n": "~10.6.0",
    "@pinia/nuxt": "~1.0.3",
    "@trpc/client": "~11.19.0",
    "@trpc/server": "~11.19.0",
    "@vue/devtools-api": "~8.2.1",
    "@vueuse/core": "~15.0.0",
    "@vueuse/nuxt": "~15.0.0",
    "comment-parser": "~1.4.9",
    "dompurify": "~3.4.17",
    "github-markdown-css": "~5.9.0",
    "h3": "~1.15.11",
    "jmespath": "~0.16.0",
    "jose": "~6.2.13",
    "jsdom": "~30.1.3",
    "json-rpc-2.0": "~1.8.1",
    "kysely": "~0.29.7",
    "marked": "~18.1.1",
    "nitropack": "~2.13.5",
    "nuxt": "~4.6.3",
    "oauth4webapi": "~3.8.8",
    "pg": "~8.23.1",
    "pinia": "~4.1.0",
    "pino": "~10.4.0",
    "pino-pretty": "~13.2.0",
    "quickjs-emscripten-core": "~0.31.0",
    "superjson": "~2.2.6",
    "tailwindcss": "~4.3.3",
    "trpc-nuxt": "~2.1.3",
    "vue": "~3.5.44",
    "vue-i18n": "~11.4.16",
    "vue-router": "~5.4.0",
    "yaml": "~2.9.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "~4.7.1",
    "@nuxt/devtools": "~3.4.4",
    "@nuxt/eslint": "~1.17.0",
    "@playwright/test": "~1.64.1",
    "@types/jmespath": "~0.15.2",
    "@types/jsdom": "~30.0.0",
    "@types/node": "~26.6.5",
    "@types/pg": "~8.23.1",
    "eslint": "~10.13.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "~17.13.0",
    "npm-run-all2": "~9.0.4",
    "prettier": "~3.9.10",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~8.3.5",
    "vitest": "~5.0.5",
    "vue-tsc": "~3.3.13"
  }
}
