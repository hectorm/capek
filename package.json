    "@pinia/nuxt": "~1.0.2",
    "@trpc/client": "~11.18.0",
    "@trpc/server": "~11.18.0",
    "@vue/devtools-api": "~8.2.1",
    "@vueuse/core": "~14.4.0",
    "@vueuse/nuxt": "~14.4.0",
    "comment-parser": "~1.4.8",
    "dompurify": "~3.4.14",
    "github-markdown-css": "~5.9.0",
    "h3": "~1.15.11",
    "jmespath": "~0.16.0",
    "jose": "~6.2.10",
