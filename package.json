    "quickjs-emscripten-core": "~0.31.0",
    "superjson": "~2.2.6",
    "tailwindcss": "~4.3.3",
    "trpc-nuxt": "~2.1.3",
    "vue": "~3.5.41",
    "vue-i18n": "~11.4.10",
    "vue-router": "~5.2.0",
    "yaml": "~2.9.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
