{
  "name": "capek",
  "version": "0.1.0",
  "description": "Conversational AI platform",
  "author": "Héctor Molinero Fernández <hector@molinero.dev>",
  "license": "EUPL-v1.2-or-later",
  "homepage": "https://github.com/hectorm/capek",
  "repository": {
    "type": "git",
    "url": "https://github.com/hectorm/capek.git"
  },
  "bugs": {
    "url": "https://github.com/hectorm/capek/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8",
  "scripts": {
    "clean": "nuxt cleanup",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt start",
    "lint": "nuxt prepare && run-p --aggregate-output lint:typecheck lint:eslint lint:prettier",
    "lint:typecheck": "vue-tsc -b --noEmit",
    "lint:eslint": "eslint --max-warnings 0 --concurrency auto --cache --cache-strategy metadata --cache-location .cache/eslint/ ./",
    "lint:prettier": "prettier --cache --cache-strategy content --cache-location .cache/prettier --list-different ./",
    "format": "run-s format:eslint format:prettier",
    "format:eslint": "eslint --fix --concurrency auto --cache --cache-strategy metadata --cache-location .cache/eslint/ ./",
    "format:prettier": "prettier --cache --cache-strategy content --cache-location .cache/prettier --write ./",
    "test": "run-s test:unit test:chromium test:firefox test:webkit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@azure/identity": "~4.14.1",
    "@clickhouse/client": "~1.24.1",
    "@electric-sql/pglite": "~0.5.14",
    "@electric-sql/pglite-socket": "~0.2.17",
    "@iconify-json/lucide": "~1.2.150",
    "@iconify-json/simple-icons": "~1.2.101",
    "@jitl/quickjs-wasmfile-release-asyncify": "~0.31.0",
    "@nuxt/fonts": "~1.2.0",
    "@nuxt/icon": "~2.5.1",
    "@nuxt/image": "~2.2.1",
    "@nuxt/ui": "~4.12.0",
    "@nuxtjs/color-mode": "~4.1.0",
    "@nuxtjs/i18n": "~10.6.0",
    "@pinia/nuxt": "~1.0.3",
    "@tediousjs/connection-string": "~1.1.0",
    "@trpc/client": "~11.23.0",
    "@trpc/server": "~11.23.0",
    "@vue/devtools-api": "~8.2.1",
    "@vueuse/core": "~15.0.0",
    "@vueuse/nuxt": "~15.0.0",
    "comment-parser": "~1.4.9",
    "dompurify": "~3.4.17",
    "github-markdown-css": "~5.9.0",
    "h3": "~1.15.11",
    "jmespath": "~0.16.0",
    "jose": "~6.2.15",
    "jsdom": "~30.1.3",
    "json-rpc-2.0": "~1.8.1",
    "kysely": "~0.29.8",
    "mariadb": "~3.5.4",
    "marked": "~18.1.3",
    "nitropack": "~2.13.6",
    "nuxt": "~4.6.4",
    "oauth4webapi": "~3.8.8",
    "pg": "~8.23.1",
    "pinia": "~4.1.0",
    "pino": "~10.4.0",
    "pino-pretty": "~13.2.0",
    "quickjs-emscripten-core": "~0.31.0",
    "superjson": "~2.2.6",
    "tailwindcss": "~4.3.4",
    "tedious": "~20.3.8",
    "trpc-nuxt": "~2.2.0",
    "vue": "~3.5.44",
    "vue-i18n": "~11.4.17",
    "vue-router": "~5.4.0",
    "yaml": "~2.9.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "~4.7.1",
    "@nuxt/devtools": "~3.4.4",
    "@nuxt/eslint": "~1.17.0",
    "@playwright/test": "~1.64.1",
    "@types/jmespath": "~0.15.2",
    "@types/jsdom": "~30.0.0",
    "@types/node": "~26.6.6",
    "@types/pg": "~8.23.1",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-vue": "~10.12.0",
    "globals": "~17.14.0",
    "npm-run-all2": "~9.0.4",
    "prettier": "~3.9.10",
    "prettier-plugin-tailwindcss": "~0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.5",
    "vitest": "~5.1.0",
    "vue-tsc": "~3.3.14"
  }
}
