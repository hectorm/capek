    "@nuxt/eslint": "~1.17.0",
    "@playwright/test": "~1.62.1",
    "@types/jmespath": "~0.15.2",
    "@types/jsdom": "~30.0.0",
    "@types/node": "~26.3.0",
    "@types/pg": "~8.23.1",
    "eslint": "~10.9.1",
