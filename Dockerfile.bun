##################################################
## "build" stage
##################################################

FROM docker.io/oven/bun:1.4.4-debian@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e AS build

ENV BUN_INSTALL=/bun
ENV PATH=${BUN_INSTALL}/bin:${PATH}
ENV NITRO_PRESET=bun

WORKDIR /src/

COPY ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml /src/

RUN --mount=type=cache,id=bun,dst=/bun/install/cache/ \
	bun install --frozen-lockfile --ignore-scripts

COPY ./ /src/

ARG FEATURES=
RUN --network=none \
	--mount=type=cache,id=bun,dst=/bun/install/cache/ \
	bun run nuxt prepare && bun run build

##################################################
## "main" stage
##################################################

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:cc66d222f0a7ec996b78a99fe76a969bc80b539a5016ad866c14d1949bc6d0ab AS main

ENV NUXT_DATABASE_URL=file:///tmp/pglite

COPY --from=build --chown=0:0 /usr/local/bin/bun /bun
COPY --from=build --chown=0:0 /src/.output/ /app/
COPY --from=build --chown=0:0 /src/bin/ /app/server/bin/

WORKDIR /app/server/

HEALTHCHECK --start-period=60s --start-interval=5s --interval=30s --timeout=5s --retries=2 \
	CMD ["/bun", "run", "/app/server/bin/healthcheck.mjs", "http://localhost:3000"]

ENTRYPOINT ["/bun", "run", "/app/server/bin/entrypoint.mjs", "/app/server/index.mjs"]
