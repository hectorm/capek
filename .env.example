COMPOSE_FILE=compose.simpleidp.yaml
COMPOSE_PROFILES=
COMPOSE_DOCKERFILE=Dockerfile
COMPOSE_BAKE=true
BUILDKIT_PROGRESS=plain

# Database
NUXT_DATABASE_URL=file://./.data/pglite

# Authentication mode (single-user, oidc or proxy)
NUXT_AUTH_MODE=single-user

# OpenID Connect Auth (when AUTH_MODE=oidc)
NUXT_OIDC_ROOT_URL=http://localhost:3000
NUXT_OIDC_REDIRECT_URI=http://localhost:3000/api/login/callback
NUXT_OIDC_CLIENT_ID=capek
NUXT_OIDC_CLIENT_SECRET=ourclientbythesewordsguarded
# Simple IdP
NUXT_OIDC_ISSUER=https://idp.localhost
NUXT_OIDC_SCOPES=openid profile email groups
# Keycloak
# NUXT_OIDC_ISSUER=https://idp.localhost/realms/acme
# NUXT_OIDC_SCOPES=openid profile email
# Dex
# NUXT_OIDC_ISSUER=https://idp.localhost/dex
# NUXT_OIDC_SCOPES=openid profile email groups

# Proxy Auth (when AUTH_MODE=proxy)
# The trusted proxy should set these headers after authenticating the user
NUXT_PROXY_HEADER_USERNAME=X-Forwarded-User
NUXT_PROXY_HEADER_FULLNAME=X-Forwarded-Preferred-Username
NUXT_PROXY_HEADER_EMAIL=X-Forwarded-Email
NUXT_PROXY_HEADER_PICTURE=X-Forwarded-Picture
NUXT_PROXY_HEADER_ROLES=X-Forwarded-Roles
NUXT_PROXY_HEADER_GROUPS=X-Forwarded-Groups

# Seed configuration (file path or inline YAML/JSON)
# NUXT_SEED_CONFIG=/path/to/seed.yaml
# NUXT_SEED_CONFIG={ users: [], groups: [] }

# Logging (fatal, error, warn, info, debug, trace)
NUXT_LOG_LEVEL=debug

# For self-signed certs in dev
NODE_TLS_REJECT_UNAUTHORIZED=0
